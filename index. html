<span class="text-pink-400">const int</span> TRIG_PIN = 4;
<span class="text-pink-400">const int</span> ECHO_PIN = 5;
<span class="text-pink-400">const int</span> WATER_PIN = A0;
<span class="text-pink-400">const int</span> BUZZER_PIN = 3;
<span class="text-pink-400">const int</span> LDR_PIN = A1;
<span class="text-pink-400">const int</span> LED_PIN = 6;

<span class="text-purple-400">void</span> <span class="text-cyan-300">setup</span>() {
  Serial.<span class="text-cyan-300">begin</span>(9600);
  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
  pinMode(BUZZER_PIN, OUTPUT);
  pinMode(LED_PIN, OUTPUT);
}

<span class="text-purple-400">void</span> <span class="text-cyan-300">loop</span>() {
  <span class="text-slate-500">// Measure Distance with Ultrasonic Sensor (HC-SR04)</span>
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);
  
  <span class="text-purple-400">long</span> duration = pulseIn(ECHO_PIN, HIGH);
  <span class="text-purple-400">int</span> distanceCm = duration * 0.034 / 2;

  <span class="text-slate-500">// Read Water Level Sensor</span>
  <span class="text-purple-400">int</span> waterVal = analogRead(WATER_PIN);

  <span class="text-slate-500">// Read LDR for automatic night headlight</span>
  <span class="text-purple-400">int</span> ldrVal = analogRead(LDR_PIN);
  <span class="text-pink-400">if</span> (ldrVal &lt; 300) {
    digitalWrite(LED_PIN, HIGH);
  } <span class="text-pink-400">else</span> {
    digitalWrite(LED_PIN, LOW);

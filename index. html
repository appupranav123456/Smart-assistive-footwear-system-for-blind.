    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #030611;
            color: #e2e8f0;
            user-select: none;
        }

        /* Glassmorphism styling */
        .glass-panel {
            background: rgba(10, 16, 35, 0.7);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid rgba(0, 240, 255, 0.2);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.5);
        }
        .glass-panel:hover {
            border-color: rgba(0, 240, 255, 0.45);
            box-shadow: 0 0 20px rgba(0, 240, 255, 0.15);
        }

        /* Glowing text & borders */
        .glow-cyan { text-shadow: 0 0 10px rgba(0, 240, 255, 0.7); }
        .glow-emerald { text-shadow: 0 0 10px rgba(16, 185, 129, 0.7); }
        .glow-pink { text-shadow: 0 0 10px rgba(255, 0, 127, 0.7); }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #040714; }
        ::-webkit-scrollbar-thumb { background: rgba(0, 240, 255, 0.3); border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(0, 240, 255, 0.7); }

        /* Range Slider Styling */
        input[type=range] {
            -webkit-appearance: none;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 6px;
            height: 6px;
        }
        input[type=range]::-webkit-slider-thumb {
            -webkit-appearance: none;
            height: 18px;
            width: 18px;
            border-radius: 50%;
            background: #00f0ff;
            box-shadow: 0 0 12px #00f0ff;
            cursor: pointer;
            transition: transform 0.1s;
        }
        input[type=range]::-webkit-slider-thumb:hover {
            transform: scale(1.25);
        }

        /* Vibration Animation for Haptic simulator */
        @keyframes haptic-vibrate {
            0% { transform: translate(0, 0) rotate(0deg); }
            20% { transform: translate(-2px, 2px) rotate(-1deg); }
            40% { transform: translate(2px, -1px) rotate(1deg); }
            60% { transform: translate(-2px, -2px) rotate(0deg); }
            80% { transform: translate(2px, 1px) rotate(1deg); }
            100% { transform: translate(0, 0) rotate(0deg); }
        }
        .vibrating {
            animation: haptic-vibrate 0.15s infinite ease-in-out;
        }

        /* Pulsing RF Wave Effect */
        @keyframes rf-pulse {
            0% { opacity: 0.2; transform: scale(0.9); }
            50% { opacity: 0.9; transform: scale(1.05); }
            100% { opacity: 0.2; transform: scale(0.9); }
        }
        .pulse-rf {
            animation: rf-pulse 1.2s infinite ease-in-out;
        }
    </style>
</head>

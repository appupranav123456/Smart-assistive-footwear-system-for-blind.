    <script>
        // State variables for simulator
        let distance = 120;
        let waterDepth = 0;
        let lightLux = 800;
        let audioEnabled = true;

        let audioCtx = null;
        let buzzerOsc = null;

        // Interactive DOM elements
        const simDistance = document.getElementById('sim-distance');
        const simWater = document.getElementById('sim-water');
        const simLight = document.getElementById('sim-light');

        const valDistance = document.getElementById('val-distance');
        const valWater = document.getElementById('val-water');
        const valLight = document.getElementById('val-light');

        const dispLaser = document.getElementById('disp-laser');
        const dispLed = document.getElementById('disp-led');
        const dispPuddle = document.getElementById('disp-puddle');
        const dispBuzzer = document.getElementById('disp-buzzer');

        const slaveBox = document.getElementById('slave-shoe-box');
        const alertBanner = document.getElementById('alert-banner');
        const alertIcon = document.getElementById('alert-icon');
        const alertText = document.getElementById('alert-text');

        // Web Audio API Sound Generator
        function playBuzzerTone(freq) {
            if (!audioEnabled) return;
            try {
                if (!audioCtx) {
                    const AudioContext = window.AudioContext || window.webkitAudioContext;
                    audioCtx = new AudioContext();
                }
                if (audioCtx.state === 'suspended') {
                    audioCtx.resume();
                }
                if (buzzerOsc) {
                    buzzerOsc.stop();
                    buzzerOsc.disconnect();
                }
                if (freq > 0) {
                    buzzerOsc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    buzzerOsc.type = 'square';
                    buzzerOsc.frequency.setValueAtTime(freq, audioCtx.currentTime);
                    gain.gain.setValueAtTime(0.04, audioCtx.currentTime);
                    buzzerOsc.connect(gain);
                    gain.connect(audioCtx.destination);
                    buzzerOsc.start();
                }
            } catch(e) { console.log(e); }
        }

        function stopBuzzer() {
            if (buzzerOsc) {
                try {
                    buzzerOsc.stop();
                    buzzerOsc.disconnect();
                    buzzerOsc = null;
                } catch(e){}
            }
        }

        // Update Simulator Telemetry
        function updateSimulation() {
            distance = parseInt(simDistance.value);
            waterDepth = parseInt(simWater.value);
            lightLux = parseInt(simLight.value);

            valDistance.innerText = distance + ' cm';
            dispLaser.innerText = distance + ' cm';

            // Puddle status
            if (waterDepth > 0) {
                valWater.innerText = `Water Detected (${waterDepth}mm)`;
                dispPuddle.innerText = `WET (${waterDepth}mm)`;
                dispPuddle.className = 'text-amber-400 font-bold';
            } else {
                valWater.innerText = 'Dry (0mm)';
                dispPuddle.innerText = 'DRY';
                dispPuddle.className = 'text-emerald-400';
            }

            // Headlight status
            if (lightLux < 300) {
                valLight.innerText = `Dark (${lightLux} Lux)`;
                dispLed.innerText = 'ON (LED HIGH)';
                dispLed.className = 'px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 border border-amber-500/40 font-bold';
            } else {
                valLight.innerText = `Bright (${lightLux} Lux)`;
                dispLed.innerText = 'OFF';
                dispLed.className = 'px-1.5 py-0.5 rounded bg-slate-800 text-slate-400';
            }

            // Alert logic calculation
            if (distance < 40) {
                // Critical Obstacle Distance
                alertBanner.className = 'p-3 rounded-xl bg-red-950/80 border border-red-500/60 flex items-center gap-3 text-xs font-mono transition';
                alertIcon.className = 'fa-solid fa-radiation text-red-400 text-lg animate-pulse';
                alertText.innerHTML = `<strong class="text-red-300">HAZARD WARNING:</strong> Obstacle close (${distance} cm)! Ultrasonic alert active.`;

                dispBuzzer.innerText = '850 Hz ALARM TONE';
                dispBuzzer.className = 'px-1.5 py-0.5 rounded bg-red-900 text-red-200 font-bold';
                playBuzzerTone(850);

            } else if (distance < 90) {
                // Moderate Distance Warning
                alertBanner.className = 'p-3 rounded-xl bg-amber-950/80 border border-amber-500/60 flex items-center gap-3 text-xs font-mono transition';
                alertIcon.className = 'fa-solid fa-circle-exclamation text-amber-400 text-lg';
                alertText.innerHTML = `<strong class="text-amber-300">PROXIMITY NOTICE:</strong> Object detected at ${distance} cm.`;

                dispBuzzer.innerText = '450 Hz BEEP TONE';
                dispBuzzer.className = 'px-1.5 py-0.5 rounded bg-amber-900 text-amber-200 font-bold';
                playBuzzerTone(450);

            } else if (waterDepth > 10) {
                // Water/Puddle Alert
                alertBanner.className = 'p-3 rounded-xl bg-teal-950/80 border border-teal-500/60 flex items-center gap-3 text-xs font-mono transition';
                alertIcon.className = 'fa-solid fa-droplet text-teal-400 text-lg';
                alertText.innerHTML = `<strong class="text-teal-300">PUDDLE DETECTED:</strong> Water depth detected on sole sensor!`;

                dispBuzzer.innerText = '300 Hz WATER ALERT';
                dispBuzzer.className = 'px-1.5 py-0.5 rounded bg-teal-900 text-teal-200 font-bold';
                playBuzzerTone(300);

            } else {
                // Nominal Safe Navigation
                alertBanner.className = 'p-3 rounded-xl bg-slate-900 border border-slate-800 flex items-center gap-3 text-xs font-mono transition';
                alertIcon.className = 'fa-solid fa-shield-halved text-cyan-400 text-base';
                alertText.innerHTML = 'System Status: Clear path ahead.';

                dispBuzzer.innerText = 'SILENT';
                dispBuzzer.className = 'px-1.5 py-0.5 rounded bg-slate-800 text-slate-500';
                stopBuzzer();
            }
        }

        // Toggle Sound Feedback
        function toggleAudioFeedback() {
            audioEnabled = !audioEnabled;
            const btn = document.getElementById('btn-audio');
            if (audioEnabled) {
                btn.innerHTML = '<i class="fa-solid fa-volume-high"></i> AUDIO ON';
                btn.className = 'px-3 py-1.5 rounded-lg bg-cyan-950 border border-cyan-600 text-cyan-300 font-bold transition';
            } else {
                btn.innerHTML = '<i class="fa-solid fa-volume-xmark"></i> AUDIO OFF';
                btn.className = 'px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-700 text-slate-500 font-bold transition';
                stopBuzzer();
            }
        }

        // Add Input Listeners
        simDistance.addEventListener('input', updateSimulation);
        simWater.addEventListener('input', updateSimulation);
        simLight.addEventListener('input', updateSimulation);

        // Initial launch
        updateSimulation();
    </script>
